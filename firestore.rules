rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function ehDono(userId) {
      return estaAutenticado() && request.auth.uid == userId;
    }

    function ehAdmin() {
      return estaAutenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    function intervaloSolicitacaoEpiDisponivel() {
      let perfil = get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;

      return !perfil.keys().hasAll([
        'ultimaRetiradaEpiEm',
        'proximaSolicitacaoEpiEm'
      ]) || perfil.proximaSolicitacaoEpiEm <= request.time;
    }

    // Perfis: o administrador gerencia tudo. O colaborador pode alterar somente
    // os campos usados pelo próprio aplicativo, sem conseguir mudar sua função de acesso.
    match /usuarios/{userId} {
      allow read: if estaAutenticado();

      allow create: if ehAdmin() || (
        ehDono(userId) &&
        request.resource.data.role == 'colaborador'
      );

      allow update: if ehAdmin() || (
        ehDono(userId) &&
        request.resource.data.role == resource.data.role &&
        (
          !request.resource.data.keys().hasAny(['cargoEpi']) ||
          request.resource.data.cargoEpi in ['motorista', 'administrativo', 'operacional']
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fcmToken',
          'cargoEpi',
          'primeiroAcesso',
          'senhaAlteradaEm'
        ])
      );

      allow delete: if ehAdmin();
    }

    match /avisos/{avisoId} {
      allow read: if estaAutenticado();
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin() || (
        estaAutenticado() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leituras'])
      );
    }

    match /cardapio/{cardapioId} {
      allow read: if estaAutenticado();
      allow write: if ehAdmin();
    }

    match /reservas_refeicao/{reservaId} {
      allow read: if estaAutenticado();
      allow create, update: if ehAdmin() || (
        estaAutenticado() &&
        (
          request.resource.data.colaboradorUid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        )
      );
      allow delete: if ehAdmin() || (
        estaAutenticado() &&
        (
          resource.data.colaboradorUid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
    }

    // Ajustes realizados pelo administrador nas refeições fixas ou manuais.
    match /excecoes_refeicao/{excecaoId} {
      allow read: if estaAutenticado();
      allow write: if ehAdmin();
    }

    // Listas definitivas geradas nos horários de corte das refeições.
    match /fechamentos_refeicoes/{fechamentoId} {
      allow read: if ehAdmin();
      allow create: if ehAdmin() &&
        request.resource.data.data is string &&
        request.resource.data.tipo in ['almoco', 'janta'] &&
        request.resource.data.limite in ['08:30', '14:00'] &&
        request.resource.data.quantidade is int &&
        request.resource.data.quantidade >= 0 &&
        request.resource.data.refeicoes is list &&
        request.resource.data.quantidade == request.resource.data.refeicoes.size();

      // Um fechamento é um retrato definitivo: depois de criado, não pode ser
      // alterado nem apagado pelo aplicativo.
      allow update, delete: if false;
    }

    match /marketplace/{anuncioId} {
      allow read: if estaAutenticado();
      allow create: if ehAdmin() || (estaAutenticado() &&
        (
          request.resource.data.vendedorUid == request.auth.uid ||
          request.resource.data.colaboradorUid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        ));
      allow update, delete: if ehAdmin() || (
        estaAutenticado() &&
        (
          resource.data.vendedorUid == request.auth.uid ||
          resource.data.colaboradorUid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
    }

    // Catálogo e saldo dos equipamentos. Todos podem consultar; somente o admin movimenta.
    match /estoque_epi/{itemId} {
      allow read: if estaAutenticado();
      allow create, update, delete: if ehAdmin();
    }

    // O colaborador cria e consulta apenas os próprios pedidos. O cancelamento
    // é permitido enquanto o pedido ainda está pendente; o restante é do admin.
    match /solicitacoes_epi/{solicitacaoId} {
      allow read: if ehAdmin() || (
        estaAutenticado() &&
        resource.data.colaboradorUid == request.auth.uid
      );

      allow create: if ehAdmin() || (estaAutenticado() &&
        request.resource.data.colaboradorUid == request.auth.uid &&
        intervaloSolicitacaoEpiDisponivel() &&
        request.resource.data.status == 'pendente' &&
        request.resource.data.cargoDeclarado in ['motorista', 'administrativo', 'operacional'] &&
        request.resource.data.itens is list &&
        request.resource.data.itens.size() > 0 &&
        request.resource.data.itens.size() <= 30 &&
        request.resource.data.totalItens is int &&
        request.resource.data.totalItens > 0 &&
        request.resource.data.keys().hasAll([
          'colaboradorUid',
          'colaboradorNome',
          'cargoDeclarado',
          'itens',
          'totalItens',
          'status',
          'criadoEm',
          'atualizadoEm'
        ]) &&
        request.resource.data.keys().hasOnly([
          'colaboradorUid',
          'colaboradorNome',
          'colaboradorEmail',
          'cargoDeclarado',
          'itens',
          'totalItens',
          'observacao',
          'status',
          'criadoEm',
          'atualizadoEm'
        ]));

      allow update: if ehAdmin() || (
        estaAutenticado() &&
        resource.data.colaboradorUid == request.auth.uid &&
        request.resource.data.colaboradorUid == request.auth.uid &&
        (
          (
            resource.data.status == 'pendente' &&
            request.resource.data.status == 'cancelado' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'canceladoEm',
              'atualizadoEm'
            ])
          ) ||
          (
            resource.data.status == 'aprovado' &&
            request.resource.data.status == 'aprovado' &&
            request.resource.data.avisoAprovacaoVisualizadoEm == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'avisoAprovacaoVisualizadoEm'
            ])
          ) ||
          (
            resource.data.status == 'retirado' &&
            request.resource.data.status == 'retirado' &&
            request.resource.data.entregaConfirmada == true &&
            request.resource.data.entregaConfirmadaPorUid == request.auth.uid &&
            request.resource.data.entregaConfirmadaEm == request.time &&
            request.resource.data.atualizadoEm == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'entregaConfirmada',
              'entregaConfirmadaEm',
              'entregaConfirmadaPorUid',
              'entregaConfirmadaPorNome',
              'atualizadoEm'
            ])
          )
        )
      );

      allow delete: if ehAdmin();
    }

    // Histórico de auditoria do estoque: visível e gravável apenas pelo administrador.
    match /movimentacoes_epi/{movimentacaoId} {
      allow read, create: if ehAdmin();
      allow update, delete: if false;
    }

    // Períodos que suspendem automaticamente as refeições do colaborador.
    match /afastamentos/{afastamentoId} {
      allow read: if ehAdmin() || (
        estaAutenticado() &&
        resource.data.colaboradorUid == request.auth.uid
      );
      allow create, update, delete: if ehAdmin();
    }

    // Registro imutável das ações administrativas mais importantes.
    match /auditoria/{registroId} {
      allow read, create: if ehAdmin();
      allow update, delete: if false;
    }

    // Configurações internas, incluindo a data do último backup.
    match /configuracoes/{configuracaoId} {
      allow read, write: if ehAdmin();
    }
  }
}
